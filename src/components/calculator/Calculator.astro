---
import { MODELS } from '../../data/models';
import { PROVIDERS } from '../../data/providers';
import ProviderIcon from '../site/ProviderIcon.astro';
import type { ProviderId } from '../../domain/models';
import type { Locale } from '../../i18n/config';
interface Props { provider?: ProviderId; locale?:Locale }
const { provider, locale='en' } = Astro.props;
const translations={
  en:{drop:'Drop files to add them',text:'Text to count',placeholder:'Paste text, a prompt, or the contents you want to count…',add:'Add files or images',show:'Show tokens',stays:'Everything stays in this browser',below:'Results appear below',live:'Live',types:'Text, code, PDF, DOCX, PNG, JPEG, WebP, or GIF · 12 MB per file',results:'Live token results',measured:'Your input, measured across providers.',choose:'Choose a provider card to inspect every available model.',words:'words',characters:'characters',attachments:'attachments',calculating:'Calculating…',details:'model details',pricing:'Bundled pricing · refreshes on use',planner:'Workload & Scaling Planner',model:'Pricing model',output:'Expected output tokens',requests:'Requests per day',call:'per call',daily:'daily',monthly:'monthly',copy:'Copy Markdown breakdown',share:'Share calculation',remove:'Remove attachment'},
  es:{drop:'Suelta archivos para añadirlos',text:'Texto que quieres contar',placeholder:'Pega texto, un prompt o el contenido que quieres contar…',add:'Añadir archivos o imágenes',show:'Mostrar tokens',stays:'Todo permanece en este navegador',below:'Los resultados aparecen abajo',live:'En vivo',types:'Texto, código, PDF, DOCX, PNG, JPEG, WebP o GIF · 12 MB por archivo',results:'Resultados de tokens en vivo',measured:'Tu entrada, medida entre proveedores.',choose:'Elige un proveedor para ver todos sus modelos.',words:'palabras',characters:'caracteres',attachments:'archivos',calculating:'Calculando…',details:'detalles del modelo',pricing:'Precios integrados · se actualizan al usar',planner:'Planificador de carga y escala',model:'Modelo de precios',output:'Tokens de salida esperados',requests:'Solicitudes por día',call:'por llamada',daily:'diario',monthly:'mensual',copy:'Copiar desglose Markdown',share:'Compartir cálculo',remove:'Eliminar archivo'},
  ja:{drop:'ファイルをドロップして追加',text:'計算するテキスト',placeholder:'計算するテキストやプロンプトを貼り付け…',add:'ファイルまたは画像を追加',show:'トークンを表示',stays:'すべてブラウザ内で処理されます',below:'結果は下に表示されます',live:'ライブ',types:'テキスト、コード、PDF、DOCX、PNG、JPEG、WebP、GIF · 1ファイル12 MB',results:'リアルタイムのトークン結果',measured:'入力を各プロバイダーで測定。',choose:'プロバイダーカードを選び、利用可能なモデルを確認します。',words:'単語',characters:'文字',attachments:'添付',calculating:'計算中…',details:'モデル詳細',pricing:'内蔵料金 · 使用時に更新',planner:'ワークロードとスケーリング',model:'料金モデル',output:'予想出力トークン',requests:'1日あたりのリクエスト',call:'1回あたり',daily:'1日',monthly:'1か月',copy:'Markdown内訳をコピー',share:'計算を共有',remove:'添付を削除'},
  de:{drop:'Dateien hier ablegen',text:'Zu zählender Text',placeholder:'Text, Prompt oder zu zählenden Inhalt einfügen…',add:'Dateien oder Bilder hinzufügen',show:'Tokens anzeigen',stays:'Alles bleibt in diesem Browser',below:'Ergebnisse erscheinen unten',live:'Live',types:'Text, Code, PDF, DOCX, PNG, JPEG, WebP oder GIF · 12 MB pro Datei',results:'Live-Token-Ergebnisse',measured:'Deine Eingabe, über Anbieter hinweg gemessen.',choose:'Wähle einen Anbieter, um alle Modelle zu prüfen.',words:'Wörter',characters:'Zeichen',attachments:'Anhänge',calculating:'Berechnung…',details:'Modelldetails',pricing:'Integrierte Preise · Aktualisierung bei Nutzung',planner:'Arbeitslast- und Skalierungsplaner',model:'Preismodell',output:'Erwartete Ausgabe-Tokens',requests:'Anfragen pro Tag',call:'pro Aufruf',daily:'täglich',monthly:'monatlich',copy:'Markdown-Aufschlüsselung kopieren',share:'Berechnung teilen',remove:'Anhang entfernen'},
  'pt-BR':{drop:'Solte arquivos para adicionar',text:'Texto para contar',placeholder:'Cole um texto, prompt ou conteúdo que deseja contar…',add:'Adicionar arquivos ou imagens',show:'Mostrar tokens',stays:'Tudo permanece neste navegador',below:'Os resultados aparecem abaixo',live:'Ao vivo',types:'Texto, código, PDF, DOCX, PNG, JPEG, WebP ou GIF · 12 MB por arquivo',results:'Resultados de tokens ao vivo',measured:'Sua entrada, medida entre provedores.',choose:'Escolha um provedor para conferir todos os modelos.',words:'palavras',characters:'caracteres',attachments:'anexos',calculating:'Calculando…',details:'detalhes do modelo',pricing:'Preços integrados · atualizados durante o uso',planner:'Planejador de carga e escala',model:'Modelo de preços',output:'Tokens de saída esperados',requests:'Solicitações por dia',call:'por chamada',daily:'diário',monthly:'mensal',copy:'Copiar detalhamento Markdown',share:'Compartilhar cálculo',remove:'Remover anexo'}
} as const;
const t=translations[locale];
const visibleModels = provider ? MODELS.filter((model) => model.provider === provider) : MODELS;
const visibleProviders = [...new Set(visibleModels.map((model) => model.provider))];
---

<section class="shell relative z-10" data-calculator data-models={JSON.stringify(visibleModels)} data-provider={provider ?? ''}>
  <div id="input-surface" class="max-w-4xl mx-auto panel composer-shadow rounded-xl overflow-hidden relative transition-colors">
    <div id="drop-overlay" class="hidden absolute inset-0 z-10 border-2 border-dashed border-[var(--accent)] bg-[color-mix(in_srgb,var(--accent)_7%,var(--panel))] place-items-center pointer-events-none"><span class="font-semibold text-[var(--accent)]">{t.drop}</span></div>
    <label for="prompt-input" class="sr-only">{t.text}</label>
    <textarea id="prompt-input" class="w-full min-h-52 sm:min-h-64 resize-y bg-transparent px-5 pt-5 sm:px-7 sm:pt-7 outline-none text-[16px] leading-7 placeholder:text-[var(--faint)]" placeholder={t.placeholder} spellcheck="false"></textarea>
    <div id="token-inspector" class="hidden min-h-52 sm:min-h-64 px-5 py-5 sm:px-7 sm:py-7 mono text-sm leading-7 flex-wrap content-start gap-1 overflow-auto" aria-label="Exact o200k token boundaries"></div>

    <div id="attachment-list" class="hidden px-5 sm:px-7 pb-3 flex flex-wrap gap-2" aria-live="polite"></div>
    <p id="input-error" class="hidden mx-5 sm:mx-7 mb-3 text-sm text-[var(--warn)]" role="alert"></p>

    <div class="border-t hairline px-4 py-3 sm:px-5 flex flex-wrap items-center gap-3">
      <label class="soft-button rounded-full h-10 px-4 flex items-center gap-2 text-sm cursor-pointer hover:border-[var(--line-strong)]">
        <input id="asset-input" class="sr-only" type="file" multiple accept=".txt,.md,.markdown,.json,.csv,.js,.jsx,.ts,.tsx,.py,.go,.rs,.java,.c,.cpp,.h,.hpp,.css,.html,.xml,.yaml,.yml,.toml,.sql,.sh,.pdf,.docx,image/png,image/jpeg,image/webp,image/gif" />
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m20.5 11.5-8.8 8.8a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 1 1-2.8-2.8l8.5-8.5"/></svg>
        {t.add}
      </label>
      <button id="token-toggle" class="soft-button rounded-full h-10 px-4 text-sm" type="button" aria-pressed="false">{t.show}</button>
      <span class="text-xs muted basis-full sm:basis-auto order-last sm:order-none">{t.stays}</span>
      <button id="view-results" class="primary-button rounded-full h-10 px-5 text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-40 disabled:cursor-default" type="button" disabled>{t.below} <span aria-hidden="true">↓</span></button>
      <span id="live-status" class="ml-auto flex items-center gap-2 text-xs text-[var(--success)]"><span class="size-1.5 rounded-full bg-[var(--success)]"></span><span>{t.live}</span></span>
    </div>
  </div>

  <p class="text-center text-xs muted mt-4">{t.types}</p>

  <p id="result-announcer" class="sr-only" aria-live="polite"></p>
  <section id="results-dashboard" class="hidden scroll-mt-24 mt-14 sm:mt-16" aria-labelledby="results-title">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-7">
      <div class="flex items-start gap-4"><span class="result-marker" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 16h3l2-8 4 12 2.5-7H20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><span class="eyebrow">{t.results}</span><h2 id="results-title" class="section-title mt-3">{t.measured}</h2><p class="muted text-sm mt-2 mb-0">{t.choose}</p></div></div>
      <div class="flex gap-6 text-sm">
        <div><span id="total-words" class="mono block text-lg">0</span><span class="muted text-xs">{t.words}</span></div>
        <div><span id="total-characters" class="mono block text-lg">0</span><span class="muted text-xs">{t.characters}</span></div>
        <div><span id="total-assets" class="mono block text-lg">0</span><span class="muted text-xs">{t.attachments}</span></div>
      </div>
    </div>

    <div class:list={["grid gap-3", visibleProviders.length > 1 ? "grid-cols-2 lg:grid-cols-4" : "max-w-sm"]} id="provider-cards">
      {visibleProviders.map((providerId, index) => (
        <button type="button" class="provider-card panel text-left rounded-xl p-4 sm:p-5 min-h-36 hover:border-[var(--line-strong)]" data-provider-card={providerId} data-active={String(index === 0)} aria-pressed={index === 0}>
          <span class="flex items-center justify-between gap-2"><span class="flex items-center gap-2.5 text-sm font-semibold text-[var(--accent)]"><ProviderIcon provider={providerId}/><span class="text-[var(--text)]">{PROVIDERS[providerId].name}</span></span><span class="mono text-[10px] muted">{PROVIDERS[providerId].short}</span></span>
          <strong class="provider-token mono block text-3xl mt-7 tracking-[-.06em]">—</strong>
          <span class="provider-label text-xs muted block mt-1">{t.calculating}</span>
        </button>
      ))}
    </div>

    <div class="panel rounded-xl overflow-hidden mt-4">
      <div class="px-5 py-4 sm:px-6 border-b hairline flex flex-wrap items-center justify-between gap-3">
        <div><span id="detail-provider" class="font-semibold">Provider</span><span class="muted text-sm ml-2">{t.details}</span></div>
        <span id="pricing-status" class="mono text-[10px] uppercase tracking-wider muted">{t.pricing}</span>
      </div>
      <div id="model-results" class="divide-y divide-[var(--line)]"></div>
    </div>

    <details id="workload-planner" class="panel rounded-xl mt-4 overflow-hidden">
      <summary class="px-5 py-4 sm:px-6 cursor-pointer font-semibold flex items-center justify-between">{t.planner} <span class="text-[var(--accent)]">+</span></summary>
      <div class="border-t hairline p-5 sm:p-6 grid lg:grid-cols-[1fr_1fr] gap-8">
        <div class="space-y-6">
          <label class="block"><span class="text-sm block mb-2">{t.model}</span><select id="planner-model" class="w-full soft-button rounded-lg px-3 py-2.5 text-sm"></select></label>
          <label class="block"><span class="flex justify-between text-sm mb-2"><span>{t.output}</span><output id="output-token-value" class="mono">500</output></span><input id="output-token-slider" class="w-full accent-[var(--accent)]" type="range" min="0" max="8000" step="100" value="500" /></label>
          <label class="block"><span class="flex justify-between text-sm mb-2"><span>{t.requests}</span><output id="request-value" class="mono">1,000</output></span><input id="request-slider" class="w-full accent-[var(--accent)]" type="range" min="0" max="10000" step="100" value="1000" /></label>
        </div>
        <div class="grid grid-cols-3 gap-px bg-[var(--line)] border hairline rounded-lg overflow-hidden">
          <div class="bg-[var(--panel)] p-4"><span id="planner-call" class="mono block text-lg">—</span><span class="text-xs muted">{t.call}</span></div>
          <div class="bg-[var(--panel)] p-4"><span id="planner-daily" class="mono block text-lg">—</span><span class="text-xs muted">{t.daily}</span></div>
          <div class="bg-[var(--panel)] p-4"><span id="planner-monthly" class="mono block text-lg">—</span><span class="text-xs muted">{t.monthly}</span></div>
        </div>
      </div>
    </details>

    <div class="flex flex-wrap gap-3 mt-4 justify-end">
      <button id="copy-breakdown" class="soft-button rounded-lg px-4 py-2.5 text-sm" type="button">{t.copy}</button>
      <button id="share-calculation" class="soft-button rounded-lg px-4 py-2.5 text-sm" type="button">{t.share}</button>
    </div>
  </section>
</section>

<template id="attachment-template">
  <span class="attachment-chip soft-button rounded-full pl-3 pr-2 py-1.5 text-xs flex items-center gap-2 max-w-full">
    <span class="attachment-name truncate"></span>
    <button type="button" class="remove-attachment size-5 grid place-items-center rounded-full hover:bg-[var(--line)]" aria-label={t.remove}>×</button>
  </span>
</template>

<script>
  import { extractDocument } from '../../engines/documents/extract';
  import { loadLivePricing } from '../../data/live-pricing';
  import { PROVIDERS } from '../../data/providers';
  import { calculateInputCost, calculateWorkloadCost, resolveRates } from '../../engines/pricing/calculate';
  import type { CalculationResult, ModelConfig, ProviderId, TokenInspectionPiece } from '../../domain/models';

  type Asset = { id:string; name:string; kind:'document'; text:string } | { id:string; name:string; kind:'image'; width:number; height:number; size:number };
  type WorkerResponse = { id:number; ok:boolean; result?:CalculationResult; pieces?:TokenInspectionPiece[]; error?:string };
  type ModelMeasurement = { model:ModelConfig; tokens:number; cost:number; ratio:number; unsupportedImages:number; method:string };

  function initializeCalculator() {
    const root = document.querySelector<HTMLElement>('[data-calculator]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const calculatorRoot = root;
    const $ = <T extends HTMLElement>(selector:string) => root.querySelector<T>(selector)!;
    let models = JSON.parse(root.dataset.models ?? '[]') as ModelConfig[];
    let assets:Asset[] = [];
    let workerId = 0;
    let calculationSequence = 0;
    let currentMeasurements:ModelMeasurement[] = [];
    let inspectionVisible = false;
    let revealAfterCalculation = false;
    let activeProvider = (root.dataset.provider || models[0]?.provider) as ProviderId;
    const preferredIds:Partial<Record<ProviderId,string>>={openai:'gpt-5.6-terra',anthropic:'claude-sonnet-5',google:'gemini-3.1-flash-lite',deepseek:'deepseek-v4-flash'};
    const pending = new Map<number, { resolve:(value:CalculationResult|TokenInspectionPiece[])=>void; reject:(reason:Error)=>void }>();
    let worker:Worker | undefined;
    const textarea = $<HTMLTextAreaElement>('#prompt-input');
    const initialQuery = new URLSearchParams(location.search);
    const initialOutput = Number(initialQuery.get('output'));
    const initialRequests = Number(initialQuery.get('requests'));
    if (initialQuery.has('output') && Number.isFinite(initialOutput) && initialOutput >= 0) $<HTMLInputElement>('#output-token-slider').value=String(Math.min(8000,initialOutput));
    if (initialQuery.has('requests') && Number.isFinite(initialRequests) && initialRequests >= 0) $<HTMLInputElement>('#request-slider').value=String(Math.min(10000,initialRequests));
    let pricingPromise:ReturnType<typeof loadLivePricing> | undefined;
    const ensurePricing = () => {
      if (pricingPromise) return pricingPromise;
      $('#pricing-status').textContent = 'Checking live pricing…';
      pricingPromise = loadLivePricing(models).then((snapshot) => {
        models = snapshot.models;
        $('#pricing-status').textContent = snapshot.source === 'models.dev' ? 'Live pricing · Models.dev' : 'Bundled pricing · offline fallback';
        return snapshot;
      });
      return pricingPromise;
    };

    const getWorker = () => {
      if (worker) return worker;
      worker = new Worker(new URL('../../workers/calculator.worker.ts', import.meta.url), { type:'module' });
      worker.onmessage = (event:MessageEvent<WorkerResponse>) => {
        const request = pending.get(event.data.id);
        if (!request) return;
        pending.delete(event.data.id);
        if (event.data.ok && event.data.result) request.resolve(event.data.result);
        else if (event.data.ok && event.data.pieces) request.resolve(event.data.pieces);
        else request.reject(new Error(event.data.error ?? 'Calculation failed.'));
      };
      worker.onerror = () => setError('The local tokenizer could not start. Reload the page and try again.');
      return worker;
    };

    const requestWorker = (modelId:string, payload:{ text?:string; image?:{ width:number; height:number; detail:'high' } }) => new Promise<CalculationResult>((resolve,reject) => {
      const id = ++workerId;
      pending.set(id,{resolve:resolve as (value:CalculationResult|TokenInspectionPiece[])=>void,reject});
      getWorker().postMessage({id,modelId,...payload});
    });
    const requestInspection = (text:string) => new Promise<TokenInspectionPiece[]>((resolve,reject)=>{
      const id=++workerId;
      pending.set(id,{resolve:resolve as (value:CalculationResult|TokenInspectionPiece[])=>void,reject});
      getWorker().postMessage({id,modelId:'gpt-5.6-terra',text,inspect:true});
    });
    const setError = (message='') => { const el=$<HTMLParagraphElement>('#input-error'); el.textContent=message; el.classList.toggle('hidden',!message); };
    const combinedText = () => [textarea.value,...assets.filter((asset):asset is Extract<Asset,{kind:'document'}>=>asset.kind==='document').map((asset)=>asset.text)].filter(Boolean).join('\n\n');
    const formatCost = (value:number) => value === 0 ? '$0.000000' : value < .000001 ? '<$0.000001' : `$${value.toFixed(6)}`;
    const formatContext = (value:number) => value >= 1_000_000 ? `${(value/1_000_000).toFixed(value%1_000_000===0?0:1)}M` : `${Math.round(value/1000)}K`;
    const setLiveStatus=(label:string,busy=false)=>{const status=$('#live-status');status.querySelector('span:last-child')!.textContent=label;status.classList.toggle('animate-pulse',busy);};

    async function renderTokenInspection() {
      const inspector=$('#token-inspector');
      if(!inspectionVisible)return;
      const text=combinedText();
      if(!text){inspector.innerHTML='<span class="muted">Add text to inspect exact token boundaries.</span>';return;}
      try {
        const pieces=await requestInspection(text);
        inspector.innerHTML='';
        const note=document.createElement('p');note.className='basis-full muted text-xs mb-2';note.textContent=`${pieces.reduce((total,piece)=>total+piece.tokenIds.length,0).toLocaleString()} exact BPE tokens. Unicode characters can span multiple tokens, so those tokens stay in one readable chip.`;inspector.append(note);
        pieces.forEach((piece)=>{const chip=document.createElement('span');chip.className='token-chip rounded px-1.5 py-0.5 whitespace-pre-wrap';chip.textContent=piece.text;chip.title=piece.tokenIds.length===1?`Token ${piece.tokenIds[0]}`:`${piece.tokenIds.length} tokens: ${piece.tokenIds.join(', ')}`;chip.setAttribute('aria-label',`${piece.tokenIds.length} token${piece.tokenIds.length===1?'':'s'}: ${piece.text}`);inspector.append(chip);});
      } catch(error) { inspector.innerHTML=`<span class="muted">${error instanceof Error?error.message:'Token inspection failed.'}</span>`; }
    }

    function renderAttachments() {
      const list=$('#attachment-list');
      list.innerHTML='';
      list.classList.toggle('hidden',assets.length===0);
      const template=document.querySelector<HTMLTemplateElement>('#attachment-template')!;
      assets.forEach((asset)=>{
        const chip=template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        chip.querySelector<HTMLElement>('.attachment-name')!.textContent=asset.name;
        chip.querySelector<HTMLButtonElement>('.remove-attachment')!.addEventListener('click',()=>{assets=assets.filter((item)=>item.id!==asset.id);renderAttachments();void calculate();});
        list.append(chip);
      });
    }

    async function addFiles(files:FileList) {
      setError();
      revealAfterCalculation=true;
      setLiveStatus('Reading files…',true);
      for (const file of [...files]) {
        try {
          const id=crypto.randomUUID();
          if (file.type.startsWith('image/')) {
            if(file.size>12*1024*1024) throw new Error(`${file.name} exceeds the 12 MB limit.`);
            const bitmap=await createImageBitmap(file);
            assets.push({id,name:file.name,kind:'image',width:bitmap.width,height:bitmap.height,size:file.size}); bitmap.close();
          } else {
            const extracted=await extractDocument(file);
            assets.push({id,name:file.name,kind:'document',text:extracted});
          }
        } catch(error) { setError(error instanceof Error?error.message:`Could not read ${file.name}.`); }
      }
      renderAttachments();
      await calculate();
    }

    async function measureModel(model:ModelConfig,text:string,images:Extract<Asset,{kind:'image'}>[]):Promise<ModelMeasurement> {
      const textResult=await requestWorker(model.id,{text});
      let tokens=textResult.tokens;
      let unsupportedImages=0;
      for(const image of images) {
        try { tokens+=(await requestWorker(model.id,{image:{width:image.width,height:image.height,detail:'high'}})).tokens; }
        catch { unsupportedImages+=1; }
      }
      return {model,tokens,cost:calculateInputCost(tokens,model),ratio:tokens/model.contextWindow,unsupportedImages,method:textResult.method};
    }

    function renderDetails(measurements:ModelMeasurement[]) {
      const providerMeasurements=measurements.filter((item)=>item.model.provider===activeProvider);
      $('#detail-provider').textContent=PROVIDERS[activeProvider].name;
      const container=$('#model-results'); container.innerHTML='';
      providerMeasurements.forEach((item)=>{
        const unsupported=item.unsupportedImages>0;
        const row=document.createElement('div');
        row.className='grid sm:grid-cols-[1.4fr_.75fr_.8fr_1fr] gap-3 sm:gap-5 px-5 py-5 sm:px-6 items-center';
        const accuracy=item.model.textAccuracy==='exact'?'Exact BPE Tokenization':'Provider-Calibrated Projection';
        const accuracyHelp=item.model.textAccuracy==='exact'?'Deterministic local count using the model family’s BPE encoding and vocabulary.':'Deterministic UTF-8 byte-ratio projection calibrated per provider tokenizer family; provider API usage remains authoritative for billing.';
        const overflow=item.ratio>1;
        const rates=resolveRates(item.model,item.tokens);
        row.innerHTML=`<div><strong class="block text-sm">${item.model.name}</strong><span class="inline-flex mt-1 text-[10px] mono rounded-full border hairline px-2 py-0.5" title="${accuracyHelp}">${accuracy}</span><span class="block text-[10px] muted mt-1">${item.method}</span><a class="inline-block text-[10px] text-[var(--accent)] mt-1" href="${item.model.pricingUrl}" target="_blank" rel="noreferrer">Official pricing ↗</a><span class="text-[10px] muted"> · verified ${item.model.verifiedAt}</span>${unsupported?'<span class="block text-xs text-[var(--warn)] mt-1">Image input unavailable</span>':''}</div><div><span class="mono block">${unsupported&&item.tokens===0?'—':item.tokens.toLocaleString()}</span><span class="text-xs muted">tokens</span></div><div><span class="mono block">${formatCost(item.cost)}</span><span class="text-xs muted">input · $${rates.inputPerMillion}/1M · cache $${rates.cachedInputPerMillion??'—'}/1M</span>${rates.label!=='Standard rate'?`<span class="block text-[10px] text-[var(--warn)] mt-1">${rates.label}</span>`:''}</div><div><div class="flex justify-between text-[10px] mono mb-1.5"><span>${(item.ratio*100).toFixed(item.ratio<.01?3:1)}%</span><span>${formatContext(item.model.contextWindow)}</span></div><div class="h-1.5 bg-[var(--panel-2)] rounded-full overflow-hidden"><div class="metric-bar h-full rounded-full" style="width:${Math.min(100,item.ratio*100)}%;background:${overflow?'var(--danger)':item.ratio>.8?'var(--warn)':'var(--accent)'}"></div></div>${overflow?`<span class="block text-[10px] text-[var(--danger)] mt-1">Context Overflow: Exceeds ${formatContext(item.model.contextWindow)} token limit</span>`:''}</div>`;
        container.append(row);
      });
      const plannerSelect=$<HTMLSelectElement>('#planner-model');
      const previous=plannerSelect.value;
      plannerSelect.innerHTML='';
      providerMeasurements.forEach((item)=>plannerSelect.add(new Option(item.model.name,item.model.id)));
      plannerSelect.value=providerMeasurements.some((item)=>item.model.id===previous)?previous:(preferredIds[activeProvider]??providerMeasurements[0]?.model.id);
      renderPlanner();
    }

    function renderPlanner() {
      const result=currentMeasurements.find((item)=>item.model.id===$<HTMLSelectElement>('#planner-model').value);
      if(!result)return;
      const outputTokens=Number($<HTMLInputElement>('#output-token-slider').value);
      const requests=Number($<HTMLInputElement>('#request-slider').value);
      const perCall=calculateWorkloadCost(result.tokens,outputTokens,result.model);
      $('#output-token-value').textContent=outputTokens.toLocaleString(); $('#request-value').textContent=requests.toLocaleString();
      $('#planner-call').textContent=formatCost(perCall); $('#planner-daily').textContent=formatCost(perCall*requests); $('#planner-monthly').textContent=formatCost(perCall*requests*30);
    }

    function renderMeasurementDashboard(measurements:ModelMeasurement[],words:number,characters:number,assetCount:number,shared=false) {
      currentMeasurements=measurements;
      $('#total-words').textContent=shared?'—':words.toLocaleString(); $('#total-characters').textContent=shared?'—':characters.toLocaleString(); $('#total-assets').textContent=shared?'—':assetCount.toLocaleString();
      calculatorRoot.querySelectorAll<HTMLElement>('[data-provider-card]').forEach((card)=>{
        const providerId=card.dataset.providerCard as ProviderId;
        const result=measurements.find((item)=>item.model.id===preferredIds[providerId])??measurements.find((item)=>item.model.provider===providerId);
        if(!result)return;
        card.querySelector<HTMLElement>('.provider-token')!.textContent=result.unsupportedImages&&result.tokens===0?'—':result.tokens.toLocaleString();
        card.querySelector<HTMLElement>('.provider-label')!.textContent=result.unsupportedImages?`${result.model.name} · image unavailable`: `${result.model.name} · ${formatCost(result.cost)}`;
      });
      renderDetails(measurements);
      const dashboard=$('#results-dashboard');dashboard.classList.remove('hidden');
      const viewResults=$<HTMLButtonElement>('#view-results');
      const preferred=measurements.find((item)=>item.model.id===preferredIds[activeProvider])??measurements[0];
      viewResults.disabled=false;viewResults.innerHTML=`View results${preferred?` · ${preferred.tokens.toLocaleString()} tokens`:''} <span aria-hidden="true">↓</span>`;
      $('#result-announcer').textContent=shared?'Shared calculation restored. For privacy, the original content is not included.':`Results updated for ${words.toLocaleString()} words and ${assetCount.toLocaleString()} attachments.`;
      if(revealAfterCalculation&&!shared){revealAfterCalculation=false;requestAnimationFrame(()=>dashboard.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'}));}
    }

    async function calculate() {
      const sequence=++calculationSequence;
      const text=combinedText();
      const images=assets.filter((asset):asset is Extract<Asset,{kind:'image'}>=>asset.kind==='image');
      if(!text.trim()&&!images.length){$('#results-dashboard').classList.add('hidden');const viewResults=$<HTMLButtonElement>('#view-results');viewResults.disabled=true;viewResults.innerHTML='Results appear below <span aria-hidden="true">↓</span>';setLiveStatus('Live');void renderTokenInspection();return;}
      setLiveStatus('Calculating…',true);
      await ensurePricing();
      const measurements=await Promise.all(models.map((model)=>measureModel(model,text,images)));
      if(sequence!==calculationSequence)return;
      const words=text.trim().match(/\S+/g)?.length??0;
      renderMeasurementDashboard(measurements,words,text.length,assets.length);
      setLiveStatus('Live');
      void renderTokenInspection();
    }

    $<HTMLInputElement>('#asset-input').addEventListener('change',(event)=>{const input=event.target as HTMLInputElement;if(input.files)addFiles(input.files);input.value='';});
    textarea.addEventListener('paste',()=>{revealAfterCalculation=true;});
    textarea.addEventListener('input',()=>{setError();void calculate().catch((error)=>{setError(error instanceof Error?error.message:'Calculation failed.');setLiveStatus('Unavailable');});});
    $('#token-toggle').addEventListener('click',async()=>{
      inspectionVisible=!inspectionVisible;
      const toggle=$<HTMLButtonElement>('#token-toggle'); toggle.setAttribute('aria-pressed',String(inspectionVisible)); toggle.textContent=inspectionVisible?'Hide tokens':'Show tokens';
      textarea.classList.toggle('hidden',inspectionVisible); const inspector=$('#token-inspector'); inspector.classList.toggle('hidden',!inspectionVisible); inspector.classList.toggle('flex',inspectionVisible);
      await renderTokenInspection();
    });

    const inputSurface=$('#input-surface'); const dropOverlay=$('#drop-overlay');
    ['dragenter','dragover'].forEach((name)=>inputSurface.addEventListener(name,(event)=>{event.preventDefault();dropOverlay.classList.remove('hidden');dropOverlay.classList.add('grid');}));
    ['dragleave','drop'].forEach((name)=>inputSurface.addEventListener(name,(event)=>{event.preventDefault();dropOverlay.classList.add('hidden');dropOverlay.classList.remove('grid');}));
    inputSurface.addEventListener('drop',(event)=>{const files=(event as DragEvent).dataTransfer?.files;if(files?.length)void addFiles(files);});

    $<HTMLInputElement>('#output-token-slider').addEventListener('input',renderPlanner);
    $<HTMLInputElement>('#request-slider').addEventListener('input',renderPlanner);
    $<HTMLSelectElement>('#planner-model').addEventListener('change',renderPlanner);
    $('#view-results').addEventListener('click',()=>$('#results-dashboard').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'}));
    calculatorRoot.querySelectorAll<HTMLElement>('[data-provider-card]').forEach((card)=>card.addEventListener('click',()=>{activeProvider=card.dataset.providerCard as ProviderId;calculatorRoot.querySelectorAll<HTMLElement>('[data-provider-card]').forEach((item)=>{const selected=item===card;item.dataset.active=String(selected);item.setAttribute('aria-pressed',String(selected));});renderDetails(currentMeasurements);}));
    $('#copy-breakdown').addEventListener('click',async()=>{
      const rows=currentMeasurements.map((item)=>`| ${PROVIDERS[item.model.provider].name} | ${item.model.name} | ${item.tokens.toLocaleString()} | ${formatCost(item.cost)} |`);
      const markdown=['| Provider | Model | Input tokens | Input cost |','|---|---|---:|---:|',...rows].join('\n');
      try { await navigator.clipboard.writeText(markdown); const button=$<HTMLButtonElement>('#copy-breakdown');button.textContent='Copied';setTimeout(()=>button.textContent='Copy Markdown breakdown',1500); }
      catch { setError('Your browser blocked clipboard access. Allow clipboard permission and try again.'); }
    });
    $('#share-calculation').addEventListener('click',async()=>{
      const result=currentMeasurements.find((item)=>item.model.id===$<HTMLSelectElement>('#planner-model').value); if(!result)return;
      const url=new URL(location.href);url.search='';url.searchParams.set('counts',currentMeasurements.map((item)=>`${item.model.id}:${item.tokens}`).join(','));url.searchParams.set('model',result.model.id);url.searchParams.set('output',$<HTMLInputElement>('#output-token-slider').value);url.searchParams.set('requests',$<HTMLInputElement>('#request-slider').value);
      try { history.replaceState(null,'',url);await navigator.clipboard.writeText(url.href);const button=$<HTMLButtonElement>('#share-calculation');button.textContent='Link copied';setTimeout(()=>button.textContent='Share calculation',1500); }
      catch { setError('The share link was created, but your browser blocked clipboard access. Copy it from the address bar.'); }
    });

    void (async()=>{
      const encoded=initialQuery.get('counts');
      if(!encoded)return;
      await ensurePricing();
      const tokenCounts=new Map(encoded.split(',').map((entry)=>{const split=entry.lastIndexOf(':');return [entry.slice(0,split),Number(entry.slice(split+1))] as const;}).filter((entry)=>entry[0]&&Number.isFinite(entry[1])&&entry[1]>=0));
      const measurements=models.filter((model)=>tokenCounts.has(model.id)).map((model)=>{const tokens=Math.round(tokenCounts.get(model.id)!);return {model,tokens,cost:calculateInputCost(tokens,model),ratio:tokens/model.contextWindow,unsupportedImages:0,method:'Restored token count; original content not shared'};});
      if(!measurements.length)return;
      const selectedModel=models.find((model)=>model.id===initialQuery.get('model'));
      if(selectedModel){activeProvider=selectedModel.provider;calculatorRoot.querySelectorAll<HTMLElement>('[data-provider-card]').forEach((card)=>{const selected=card.dataset.providerCard===activeProvider;card.dataset.active=String(selected);card.setAttribute('aria-pressed',String(selected));});}
      renderMeasurementDashboard(measurements,0,0,0,true);
      if(selectedModel&&$<HTMLSelectElement>('#planner-model').querySelector(`option[value="${CSS.escape(selectedModel.id)}"]`))$<HTMLSelectElement>('#planner-model').value=selectedModel.id;
      renderPlanner();setLiveStatus('Shared result');
    })().catch(()=>setError('This shared calculation could not be restored.'));
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initializeCalculator,{once:true});else initializeCalculator();
</script>
