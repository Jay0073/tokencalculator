---
interface Item { label:string; href?:string }
interface Props { items:Item[] }
const { items }=Astro.props;
---
<nav class="shell pt-6 relative z-10" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-xs muted list-none p-0 m-0">
    {items.map((item,index)=><li class="flex items-center gap-2">
      {index > 0 && <span aria-hidden="true">/</span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
    </li>)}
  </ol>
</nav>
