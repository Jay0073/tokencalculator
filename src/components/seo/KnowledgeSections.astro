---
import type { ProviderId } from '../../domain/models';
import { MODELS } from '../../data/models';
import { PROVIDERS } from '../../data/providers';
import UseCaseReviews from './UseCaseReviews.astro';
import { FEATURED_REVIEWS } from '../../data/reviews';
import { rate } from '../../lib/format';
import type { Locale } from '../../i18n/config';
import { sectionCopy } from '../../i18n/sections';

// Where each model sits on the catalogue's cost scale. Log scaled, because the rates run
// from $0.03 to $75 per million and a linear scale would crowd almost everything left.
const blended = (model: { inputPerMillion: number; outputPerMillion: number }) => (model.inputPerMillion + model.outputPerMillion) / 2;
const allRates = MODELS.map(blended).filter((value) => value > 0);
const lowestRate = Math.log10(Math.min(...allRates));
const highestRate = Math.log10(Math.max(...allRates));
const costPosition = (model: { inputPerMillion: number; outputPerMillion: number }) =>
  Math.min(1, Math.max(0, (Math.log10(blended(model)) - lowestRate) / (highestRate - lowestRate)));
const costStep = (model: { inputPerMillion: number; outputPerMillion: number }) => Math.min(5, Math.max(1, Math.ceil(costPosition(model) * 5)));

interface Props { provider?:ProviderId; locale?:Locale }
const { provider,locale='en' }=Astro.props;
const copy=sectionCopy[locale];
const providerModels=provider ? MODELS.filter((model)=>model.provider===provider) : [];
const reviewed=MODELS.map((model)=>model.verifiedAt).sort().at(-1) ?? '2026-08-22';
const providerName=provider ? PROVIDERS[provider].name : '';
// Stable provider order for the homepage pricing table, derived from the catalogue so
// a newly synced provider appears without another edit here.
const providerOrder=[...new Set(MODELS.map((model)=>model.provider))];

const providerCopy:Record<ProviderId,{method:string;difference:string;image:string;source:string}>={
  openai:{method:'OpenAI text is counted locally with the BPE encoding assigned to the selected model. This measures the raw content exactly; API message wrappers, tool definitions, and provider-side instructions can add tokens.',difference:'Different GPT model families can use different encodings. The selected model determines the tokenizer, context limit, and price used by the calculator.',image:'For supported vision models, the browser reads image dimensions and applies OpenAI’s published detail and tile rules. The image is never uploaded.',source:'https://developers.openai.com/api/docs/models/compare'},
  anthropic:{method:'Claude text uses the deterministic Provider-Calibrated UTF-8 Token Projection because Anthropic does not distribute its production tokenizer as a lightweight offline browser package. UTF-8 byte length is normalized by an Anthropic-family bytes-per-token coefficient.',difference:'Punctuation, code, JSON, Unicode composition, non-English text, and API message framing can shift the final Claude usage reported by Anthropic.',image:'Claude image tokens use Anthropic’s published 28×28 visual-patch method and the applicable model cap. Only dimensions are read locally.',source:'https://platform.claude.com/docs/en/build-with-claude/vision'},
  google:{method:'Gemini text uses the deterministic Provider-Calibrated UTF-8 Token Projection. Google’s countTokens API remains authoritative after the complete API request, including instructions and attached content, is assembled.',difference:'Gemini uses different tokenizer and multimodal processing semantics from GPT or Claude, so token totals should not be transferred between providers.',image:'Image dimensions are converted with Google’s published media-token allocation guidance. The selected Gemini model determines the context window and pricing applied.',source:'https://ai.google.dev/gemini-api/docs/tokens'},
  deepseek:{method:'DeepSeek text uses the deterministic Provider-Calibrated UTF-8 Token Projection. The engine applies a DeepSeek-family bytes-per-token coefficient, then evaluates context-window utilization and current input pricing.',difference:'Reasoning, chat templates, request framing, and server-side processing can make billed usage differ from the raw-input projection shown here.',image:'When the selected DeepSeek API model has no documented vision-token specification, the calculator returns an unsupported state instead of fabricating a count.',source:'https://api-docs.deepseek.com/quick_start/pricing/'},
  alibaba:{method:'Qwen text uses the deterministic Provider-Calibrated UTF-8 Token Projection with a Qwen-family bytes-per-token coefficient. Alibaba Cloud Model Studio remains authoritative for billed usage.',difference:'Qwen vocabularies are tuned for both Chinese and English, so a Latin-only prompt projects differently from the same prompt measured on a GPT tokenizer. Mixed-script and CJK content shifts the ratio further.',image:'Qwen vision-language variants are excluded from this calculator because their image-token rules are not published in a form that can be reproduced offline. Text and code are measured; images report as unsupported.',source:'https://www.alibabacloud.com/help/en/model-studio/models'},
  moonshotai:{method:'Kimi text uses the deterministic Provider-Calibrated UTF-8 Token Projection with a Moonshot-family bytes-per-token coefficient, then applies the selected model context window and published rates.',difference:'Kimi models target very long context. A projection that is accurate on a short prompt can drift over a million-token document, so treat long-context totals as planning figures and confirm against the provider response.',image:'Moonshot does not publish an offline-reproducible image-token formula for the Kimi models listed here, so image input reports as unsupported rather than being estimated.',source:'https://platform.moonshot.ai/docs/pricing'},
  xai:{method:'Grok text uses the deterministic Provider-Calibrated UTF-8 Token Projection. The engine applies an xAI-family bytes-per-token coefficient and the selected model context window.',difference:'xAI ships frequent model revisions, and rates move with them. The rate shown carries the date it was verified against the public catalogue; confirm against your invoice before committing a budget.',image:'Image-token rules for Grok vision models are not published in a form this calculator can reproduce locally, so image input reports as unsupported.',source:'https://docs.x.ai/docs/models'},
  zai:{method:'GLM text uses the deterministic Provider-Calibrated UTF-8 Token Projection with a Z.ai-family bytes-per-token coefficient, followed by context-window and cost projection.',difference:'GLM tokenizers are optimised for Chinese and English together. English-only prompts and CJK prompts project at noticeably different bytes-per-token ratios, so do not carry a ratio across languages.',image:'Image-token rules for GLM vision variants are not published in an offline-reproducible form, so image input reports as unsupported instead of being guessed.',source:'https://docs.z.ai/guides/overview/pricing'},
  meta:{method:'Meta text uses the deterministic Provider-Calibrated UTF-8 Token Projection with a Llama-family bytes-per-token coefficient, then applies the selected model context window and published rates.',difference:'Meta models are served by many hosts at different prices. The rate shown is the first-party published rate; a reseller or cloud marketplace can bill differently for the same model.',image:'Image-token rules for Meta multimodal models are not published in a form this calculator can reproduce offline, so image input reports as unsupported.',source:'https://llama.developer.meta.com/docs/models'},
};
---
{provider ? (
  <>
    <section class="content-band shell relative z-10" aria-labelledby="provider-method-title">
      <div class="content-heading"><span class="eyebrow">{providerName} methodology</span><h2 id="provider-method-title" class="section-title mt-3">How this {providerName} token calculator works</h2></div>
      <div class="content-copy muted"><p>{providerCopy[provider].method}</p><p>{providerCopy[provider].difference}</p><p>{providerCopy[provider].image}</p><a href={providerCopy[provider].source} target="_blank" rel="noreferrer" class="text-[var(--accent)]">Read the official {providerName} documentation ↗</a></div>
    </section>

    <section class="shell mt-20 relative z-10" aria-labelledby="models-title">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-7"><div><span class="eyebrow">Curated production models</span><h2 id="models-title" class="section-title mt-3">Models included in this counter</h2></div><p class="mono text-xs muted m-0">Registry reviewed {reviewed}</p></div>
      <div class="table-shell overflow-x-auto"><table class="seo-table"><thead><tr><th>Model</th><th>Tokenization method</th><th>Context window</th><th>Input / 1M</th><th>Output / 1M</th></tr></thead><tbody>{providerModels.map((model)=><tr><td><strong>{model.name}</strong></td><td>{model.textAccuracy==='exact'?'Exact local BPE':'Provider-Calibrated UTF-8 Projection'}</td><td data-live-context={model.id}>{model.contextWindow.toLocaleString()}</td><td data-live-input={model.id}>{rate(model.inputPerMillion)}</td><td data-live-output={model.id}>{rate(model.outputPerMillion)}</td></tr>)}</tbody></table></div>
      <p class="text-xs muted mt-4">Rates shown are USD per 1,000,000 tokens, verified against the public pricing catalogue on {reviewed}. The table refreshes from the same live source the calculator uses. Provider invoices and official documentation remain authoritative.</p>
    </section>
  </>
) : (
  <>
    <section class="content-band shell relative z-10" aria-labelledby="measure-title">
      <div class="content-heading"><span class="eyebrow">{copy.measures.eyebrow}</span><h2 id="measure-title" class="section-title mt-3">{copy.measures.title}</h2></div>
      <div class="content-copy muted"><p>{copy.measures.lead(MODELS.length,providerOrder.length,providerOrder.map((id)=>PROVIDERS[id].name).join(', '))}</p><p>{copy.measures.body}</p></div>
    </section>

    <section class="shell mt-20 relative z-10" aria-labelledby="pricing-title">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-7"><div><span class="eyebrow">{copy.pricing.eyebrow}</span><h2 id="pricing-title" class="section-title mt-3">{copy.pricing.title}</h2></div><p class="mono text-xs muted m-0">{copy.pricing.verified} {reviewed}</p></div>
      <p class="muted max-w-3xl mt-0 mb-6">{copy.pricing.intro}</p>
      <div class="table-shell overflow-x-auto"><table class="seo-table price-table">
        <thead><tr><th>{copy.pricing.columns.model}</th><th>{copy.pricing.columns.scale}</th><th class="num">{copy.pricing.columns.context}</th><th class="num">{copy.pricing.columns.input}</th><th class="num">{copy.pricing.columns.cached}</th><th class="num">{copy.pricing.columns.output}</th></tr></thead>
        <tbody>
        {providerOrder.flatMap((providerId)=>MODELS.filter((model)=>model.provider===providerId).map((model,index)=>(
          <tr class={index===0?'group-start':undefined}>
            <td><strong>{model.name}</strong>{index===0 && <span class="group-name">{PROVIDERS[model.provider].name}</span>}</td>
            <td><span class="scale" aria-hidden="true" style={`--reading:${Math.round(costPosition(model)*100)}%;--tone:var(--cost-${costStep(model)})`}><i></i><b></b></span></td>
            <td class="num figure" data-live-context={model.id}>{model.contextWindow.toLocaleString()}</td>
            <td class="num figure" data-live-input={model.id}>{rate(model.inputPerMillion)}</td>
            <td class="num figure muted">{rate(model.cachedInputPerMillion)}</td>
            <td class="num figure" data-live-output={model.id}>{rate(model.outputPerMillion)}</td>
          </tr>
        )))}
      </tbody></table></div>
      <p class="text-xs muted mt-4">{copy.pricing.footnote}</p>
    </section>

    <section class="shell mt-20 relative z-10" aria-labelledby="flow-title">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-7"><div><span class="eyebrow">{copy.pipeline.eyebrow}</span><h2 id="flow-title" class="section-title mt-3">{copy.pipeline.title}</h2></div><p class="muted max-w-lg m-0">{copy.pipeline.deck}</p></div>
      <figure class="measurement-flow panel rounded-2xl p-5 sm:p-7 m-0" aria-labelledby="flow-caption">
        <ol class="flow-mobile list-none p-0 m-0" aria-label={copy.pipeline.svgTitle}>
          {copy.pipeline.steps.map((step)=><li><span>{step.label}</span><strong>{step.title}</strong><small>{step.note}</small></li>)}
        </ol>
        <svg class="flow-desktop" viewBox="0 0 1040 210" role="img" aria-labelledby="flow-svg-title flow-svg-desc">
          <title id="flow-svg-title">{copy.pipeline.svgTitle}</title><desc id="flow-svg-desc">{copy.pipeline.svgDesc}</desc>
          <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="var(--faint)"/></marker></defs>
          <g class="flow-lines" fill="none" stroke="var(--faint)" stroke-width="2" marker-end="url(#arrow)"><path d="M238 105h70"/><path d="M493 105h70"/><path d="M748 105h70"/></g>
          {copy.pipeline.steps.map((step,index)=>{
            // Wider boxes than the original four, because every language except English
            // needs more room for the same four words.
            const geometry=[{x:20,width:218},{x:308,width:185},{x:563,width:185},{x:818,width:185}][index];
            return (
              <g class="flow-node"><rect x={geometry.x} y="40" width={geometry.width} height="130" rx="18"/><text x={geometry.x+25} y="82" class="flow-label">{step.label.toUpperCase()}</text><text x={geometry.x+25} y="119" class="flow-title">{step.short}</text><text x={geometry.x+25} y="145" class="flow-note">{step.shortNote}</text></g>
            );
          })}
        </svg>
        <figcaption id="flow-caption" class="text-sm muted mt-3">{copy.pipeline.caption}</figcaption>
      </figure>
    </section>

    <section class="content-band shell relative z-10" aria-labelledby="file-counter-title">
      <div class="content-heading"><span class="eyebrow">{copy.files.eyebrow}</span><h2 id="file-counter-title" class="section-title mt-3">{copy.files.title}</h2></div>
      <div class="content-copy muted">{copy.files.body.map((paragraph)=><p>{paragraph}</p>)}<p><strong>{copy.files.privacyLabel}</strong> {copy.files.privacy}</p></div>
    </section>

    <section class="content-band shell relative z-10" aria-labelledby="image-counter-title">
      <div class="content-heading"><span class="eyebrow">{copy.images.eyebrow}</span><h2 id="image-counter-title" class="section-title mt-3">{copy.images.title}</h2></div>
      <div class="content-copy muted">{copy.images.body.map((paragraph)=><p>{paragraph}</p>)}</div>
    </section>

    <UseCaseReviews reviews={FEATURED_REVIEWS} {locale}/>

    <section class="shell mt-20 relative z-10" aria-labelledby="accuracy-title">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-7"><div><span class="eyebrow">{copy.accuracy.eyebrow}</span><h2 id="accuracy-title" class="section-title mt-3">{copy.accuracy.title}</h2></div><p class="mono text-xs muted m-0">{copy.accuracy.reviewed} {reviewed}</p></div>
      <div class="table-shell overflow-x-auto"><table class="seo-table"><thead><tr><th>{copy.accuracy.columns.provider}</th><th>{copy.accuracy.columns.text}</th><th>{copy.accuracy.columns.image}</th><th>{copy.accuracy.columns.label}</th></tr></thead><tbody>
        <tr><td><a href="/openai-token-counter/"><strong>OpenAI</strong></a></td><td>{copy.accuracy.methods.localBpe}</td><td>{copy.accuracy.methods.tiles}</td><td>{copy.accuracy.methods.exact}</td></tr>
        <tr><td><a href="/claude-token-counter/"><strong>Claude</strong></a></td><td>{copy.accuracy.methods.projection}</td><td>{copy.accuracy.methods.patches}</td><td>{copy.accuracy.methods.deterministic}</td></tr>
        <tr><td><a href="/gemini-token-counter/"><strong>Gemini</strong></a></td><td>{copy.accuracy.methods.projection}</td><td>{copy.accuracy.methods.media}</td><td>{copy.accuracy.methods.deterministic}</td></tr>
        <tr><td><a href="/deepseek-token-counter/"><strong>DeepSeek</strong></a></td><td>{copy.accuracy.methods.projection}</td><td>{copy.accuracy.methods.unavailable}</td><td>{copy.accuracy.methods.deterministic}</td></tr>
      </tbody></table></div>
    </section>

    <section class="shell mt-20 relative z-10" aria-labelledby="terms-title">
      <span class="eyebrow">{copy.terms.eyebrow}</span><h2 id="terms-title" class="section-title mt-3 mb-8">{copy.terms.title}</h2>
      <dl class="definition-grid">
        {copy.terms.items.map((item)=><div><dt>{item.term}</dt><dd>{item.definition}</dd></div>)}
      </dl>
    </section>
  </>
)}
