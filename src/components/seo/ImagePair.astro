---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FAQ from './FAQ.astro';
import { BASIS_LABEL, IMAGE_PAGES, IMAGE_PRICES_CHECKED, getImageModel, imageUsd } from '../../data/image-models';

// Shared template for image-model comparison pages. Image APIs bill per image or per
// image token, so these pages cannot reuse the text-token calculator; they price images.
interface Props {
  slug: string;
  leftId: string;
  rightId: string;
  title: string;
  description: string;
  crumb: string;
  heading: string;
  intro: string;
  decision: string;
  analysis: { heading: string; body: string[] }[];
  faq: { question: string; answer: string }[];
}
const props = Astro.props;
const pair = [getImageModel(props.leftId), getImageModel(props.rightId)];
const canonical = `/${props.slug}/`;
const breadcrumbs = [{ label: 'Token calculator', href: '/' }, { label: 'Compare models', href: '/compare/' }, { label: props.crumb }];
const VOLUME = 10000;
const others = IMAGE_PAGES.filter((page) => page.href !== canonical);
const checked = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${IMAGE_PRICES_CHECKED}T00:00:00Z`));
---
<BaseLayout title={props.title} description={props.description} {canonical} faq={props.faq} {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="shell max-w-4xl pt-12 sm:pt-16 pb-8 relative z-10">
    <span class="eyebrow">Image model comparison</span>
    <h1 class="m-0 mt-4 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.02] tracking-[-.055em] max-w-4xl">{props.heading}</h1>
    <p class="muted text-[16px] sm:text-[17px] mt-4 mb-0 max-w-3xl">{props.intro}</p>
  </section>

  <section class="shell relative z-10 mb-10" aria-labelledby="price-title">
    <div class="panel p-5 sm:p-7">
      <h2 id="price-title" class="section-title m-0 mb-5">Price per generated image</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {pair.map((model) => (
          <div>
            <h3 class="m-0 text-lg">{model.name} <span class="muted font-normal text-sm">· {model.lab}</span></h3>
            <p class="muted text-xs mt-1 mb-3"><code>{model.apiId}</code> · {model.status} · {BASIS_LABEL[model.priceBasis]}</p>
            <table class="w-full text-left text-sm">
              <thead><tr class="muted"><th class="pb-2 font-normal">Size and quality</th><th class="pb-2 font-normal text-right">Per image</th><th class="pb-2 font-normal text-right">Batch</th></tr></thead>
              <tbody>{model.prices.map((price) => <tr class="border-t hairline"><td class="py-2 pr-3">{price.label}</td><td class="py-2 text-right mono">{imageUsd(price.usd)}</td><td class="py-2 text-right mono">{price.batchUsd === undefined ? '—' : imageUsd(price.batchUsd)}</td></tr>)}</tbody>
            </table>
            <p class="muted text-xs mt-3 mb-0">{model.basisNote}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="shell relative z-10 mb-10" aria-labelledby="monthly-title">
    <div class="panel p-5 sm:p-7" data-image-estimator>
      <h2 id="monthly-title" class="section-title m-0 mb-2">Monthly cost at your volume</h2>
      <p class="muted text-sm mt-0 mb-5">Standard processing, output images only. Add your retry rate and any editing on top.</p>
      <label class="flex flex-wrap items-center gap-3 text-sm mb-5">Images per month
        <input class="h-10 w-40 rounded-lg border hairline bg-[var(--panel)] px-3 mono" type="number" min="0" step="1000" value={VOLUME} data-image-volume />
      </label>
      <table class="w-full text-left text-sm">
        <thead><tr class="muted"><th class="pb-2 font-normal">Model and tier</th><th class="pb-2 font-normal text-right">Per image</th><th class="pb-2 font-normal text-right">Per month</th></tr></thead>
        <tbody>
          {pair.flatMap((model) => model.standard.map((price) => (
            <tr class="border-t hairline"><td class="py-2 pr-3">{model.name} · {price.label}</td><td class="py-2 text-right mono">{imageUsd(price.usd)}</td><td class="py-2 text-right mono" data-image-price={price.usd}>${(price.usd * VOLUME).toLocaleString('en-US', { maximumFractionDigits: 0 })}</td></tr>
          )))}
        </tbody>
      </table>
    </div>
  </section>

  {props.analysis.map((block) => (
    <section class="shell mt-16 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-8 md:gap-16 relative z-10">
      <div><h2 class="section-title m-0">{block.heading}</h2></div>
      <div class="muted">{block.body.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>
  ))}

  <section class="shell mt-16 grid md:grid-cols-2 gap-8 md:gap-16 relative z-10">
    <div><span class="eyebrow">Decision rule</span><h2 class="section-title mt-3">Price the size and quality you will ship.</h2></div>
    <div class="muted"><p>{props.decision}</p><a href="/docs/image-generation-cost/" class="text-[var(--accent)]">How image generation APIs bill →</a></div>
  </section>

  <section class="shell mt-16 relative z-10">
    <span class="eyebrow">More image comparisons</span>
    <div class="grid md:grid-cols-2 gap-3 mt-4">
      {others.map((page) => <a href={page.href} class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><strong>{page.title}</strong><span class="block text-sm muted mt-1">{page.detail}</span></a>)}
    </div>
  </section>

  <FAQ items={props.faq} />

  <section class="shell mt-12 mb-8 relative z-10">
    <div class="source-ledger mt-0"><h2>Sources</h2><p><strong>Prices checked:</strong> {checked}. Image prices change often; provider pricing pages remain authoritative.</p><ul>
      {pair.flatMap((model) => model.sources).filter((source, index, all) => all.findIndex((other) => other.url === source.url) === index).map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>)}
      <li><a href="https://arena.ai/leaderboard/text-to-image" target="_blank" rel="noreferrer">Arena text-to-image leaderboard</a> (updated 7 September 2026)</li>
    </ul></div>
  </section>
</BaseLayout>

<script>
  // Recompute the monthly column when the volume changes. The server already rendered
  // the numbers for 10,000 images, so the table is complete without JavaScript.
  for (const root of document.querySelectorAll<HTMLElement>('[data-image-estimator]')) {
    const input = root.querySelector<HTMLInputElement>('[data-image-volume]');
    const cells = root.querySelectorAll<HTMLElement>('[data-image-price]');
    input?.addEventListener('input', () => {
      const volume = Math.max(0, Number(input.value) || 0);
      cells.forEach((cell) => { cell.textContent = `$${(Number(cell.dataset.imagePrice) * volume).toLocaleString('en-US', { maximumFractionDigits: 0 })}`; });
    });
  }
</script>
