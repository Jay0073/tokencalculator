---
interface Props {
  /** Slug of the page being rendered, so it does not link to itself. */
  current?: string;
  /** How many comparison cards to show. Comparison pages show a related subset
      rather than the full list, which keeps repeated boilerplate off every page. */
  limit?: number;
}
const { current, limit } = Astro.props;

const COMPARISONS = [
  { href: '/gpt-6-astra-vs-claude-fable-5-1-cost/', title: 'GPT-6 Astra vs Claude Fable 5.1', detail: 'Same headline price, four-fold cached-input gap' },
  { href: '/gpt-5-6-sol-vs-claude-opus-4-8-cost/', title: 'GPT-5.6 Sol vs Claude Opus 4.8', detail: 'Frontier text, document, image, and output cost' },
  { href: '/gpt-5-6-terra-vs-claude-sonnet-5-pricing/', title: 'GPT-5.6 Terra vs Claude Sonnet 5', detail: 'Balanced production-model pricing' },
  { href: '/deepseek-v4-pro-vs-gpt-5-6-sol-cost/', title: 'DeepSeek V4 Pro vs GPT-5.6 Sol', detail: 'Reasoning workload comparison' },
  { href: '/deepseek-v4-flash-vs-gpt-5-6-luna-pricing/', title: 'DeepSeek V4 Flash vs GPT-5.6 Luna', detail: 'High-volume token pricing' },
  { href: '/gemini-3-1-flash-lite-vs-gpt-5-6-luna-cost/', title: 'Gemini 3.1 Flash-Lite vs GPT-5.6 Luna', detail: 'Multimodal image and document cost' },
  { href: '/kimi-k3-vs-claude-fable-5-1-cost/', title: 'Kimi K3 vs Claude Fable 5.1', detail: 'Open-weight challenger against the frontier' },
  { href: '/qwen3-8-max-vs-gpt-5-6-sol-cost/', title: 'Qwen3.8 Max vs GPT-5.6 Sol', detail: 'Multilingual tokenizer and price gap' },
  { href: '/glm-5-3-vs-deepseek-v4-pro-pricing/', title: 'GLM-5.3 vs DeepSeek V4 Pro', detail: 'Low-cost open-weight comparison' },
  { href: '/claude-vs-gpt4o-token-cost/', title: 'Claude vs GPT token cost', detail: 'What replaced GPT-4o in the balanced tier' },
  { href: '/deepseek-r1-vs-openai-o1-cost-calculator/', title: 'DeepSeek vs OpenAI reasoning cost', detail: 'Successors to R1 and o1, priced on output' },
  { href: '/gemini-flash-vs-gpt-4o-mini-pricing/', title: 'Gemini Flash vs GPT mini', detail: 'The cheap tier after GPT-4o mini' },
];

const GUIDES = [
  { href: '/prompt-caching-cost/', title: 'Prompt caching cost', detail: 'What a cached prefix saves on a 20-turn agent loop' },
  { href: '/long-context-vs-rag-cost/', title: 'Long context vs RAG cost', detail: 'Stuffing a 1M window against retrieval, priced per query' },
];

const guides = GUIDES.filter((item) => item.href !== current);
const shown = COMPARISONS.filter((item) => item.href !== current).slice(0, limit ?? COMPARISONS.length);
---
<section class="shell mt-24 relative z-10">
  <span class="eyebrow">Focused counters</span><h2 class="section-title mt-3 mb-8">Measure against the model you use</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <a href="/openai-token-counter/" class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><span class="mono text-xs text-[var(--accent)]">OAI</span><strong class="block mt-5">OpenAI token counter</strong><span class="text-sm muted">Exact local o200k_base BPE</span></a>
    <a href="/claude-token-counter/" class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><span class="mono text-xs text-[var(--accent)]">ANT</span><strong class="block mt-5">Claude token counter</strong><span class="text-sm muted">Provider-Calibrated UTF-8 Projection</span></a>
    <a href="/gemini-token-counter/" class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><span class="mono text-xs text-[var(--accent)]">GOO</span><strong class="block mt-5">Gemini token counter</strong><span class="text-sm muted">Text and image rules</span></a>
    <a href="/deepseek-token-counter/" class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><span class="mono text-xs text-[var(--accent)]">DSK</span><strong class="block mt-5">DeepSeek token counter</strong><span class="text-sm muted">Current API pricing</span></a>
  </div>
</section>
<section class="shell mt-16 relative z-10">
  <span class="eyebrow">Current model comparisons</span><h2 class="section-title mt-3 mb-8">{current ? 'Other comparisons worth running' : 'Compare cost with the same real workload'}</h2>
  <div class="grid md:grid-cols-2 gap-3">
    {shown.map((item) => (
      <a href={item.href} class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><strong>{item.title}</strong><span class="block text-sm muted mt-1">{item.detail}</span></a>
    ))}
  </div>
</section>
<section class="shell mt-16 relative z-10">
  <span class="eyebrow">Cost guides</span><h2 class="section-title mt-3 mb-8">Compare approaches, not just models</h2>
  <div class="grid md:grid-cols-2 gap-3">
    {guides.map((item) => (
      <a href={item.href} class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><strong>{item.title}</strong><span class="block text-sm muted mt-1">{item.detail}</span></a>
    ))}
  </div>
</section>
