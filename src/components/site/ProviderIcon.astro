---
import type { ProviderId } from '../../domain/models';
interface Props { provider:ProviderId; size?:number }
const { provider, size=18 }=Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
  {provider==='openai' && <><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></>}
  {provider==='anthropic' && <><path d="M5 18 11.1 5.5c.35-.7 1.35-.7 1.7 0L19 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 14h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></>}
  {provider==='google' && <><path d="M12 3c.7 4.7 3.3 7.3 8 8-4.7.7-7.3 3.3-8 8-.7-4.7-3.3-7.3-8-8 4.7-.7 7.3-3.3 8-8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></>}
  {provider==='deepseek' && <><path d="M3.5 14.5c2.2-3.2 4.6-4.8 7.3-4.8 3.3 0 4.3 2.4 6.6 2.4 1.1 0 2.1-.4 3.1-1.2-1.1 4.3-3.8 7.1-8.2 7.1-3.7 0-6.6-1.2-8.8-3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="15.8" cy="8" r="1" fill="currentColor"/></>}
</svg>
