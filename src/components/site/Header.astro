---
import BrandMark from './BrandMark.astro';
---
<header class="site-header relative z-20">
  <div class="shell h-[72px] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label="TokenCalculator.dev home">
      <BrandMark />
      <span class="font-semibold tracking-[-.035em] text-[15px]">TokenCalculator<span class="text-[var(--accent)]">.dev</span></span>
    </a>
    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="hidden md:flex items-center gap-5 text-xs text-[var(--muted)]" aria-label="Provider tools"><a href="/openai-token-counter">OpenAI</a><a href="/claude-token-counter">Claude</a><a href="/gemini-token-counter">Gemini</a><a href="/deepseek-token-counter">DeepSeek</a></nav>
      <span class="flex items-center gap-2 text-xs muted sm:border-l hairline sm:pl-4"><span class="size-1.5 rounded-full bg-[var(--success)]"></span><span class="hidden sm:inline">Local processing</span><span class="sm:hidden">Local</span></span>
      <button id="theme-toggle" class="size-9 grid place-items-center border hairline rounded-full bg-[var(--panel)] text-[var(--muted)] hover:text-[var(--text)]" type="button" aria-label="Toggle color theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c-5 2-11-4-9-9Z"/></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const saved = localStorage.getItem('theme');
  if (saved !== 'dark') root.classList.add('light');
  document.querySelector('#theme-toggle')?.addEventListener('click', () => {
    root.classList.toggle('light');
    localStorage.setItem('theme', root.classList.contains('light') ? 'light' : 'dark');
  });
</script>
