---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from './calculator/Calculator.astro';
import FAQ from './seo/FAQ.astro';
import ProviderLinks from './seo/ProviderLinks.astro';
import type { ProviderId } from '../domain/models';

interface Props { provider?:ProviderId; title:string; description:string; eyebrow:string; heading:string; intro:string; canonical:string; methodology:string }
const { provider,title,description,eyebrow,heading,intro,canonical,methodology }=Astro.props;
const faq=[
  {question:'Does this tool upload my prompt or files?',answer:'No. Text, document extraction, image dimensions, and token calculations run in your browser. Your content is not sent to TokenCalculator.dev.'},
  {question:'Are the token counts exact?',answer:'OpenAI text counts use the matching local BPE encoding. Other providers are clearly labeled estimates unless they publish a deterministic local formula. Image counts use provider-published rules.'},
  {question:'Can I count tokens in PDF and DOCX files?',answer:'Text-based PDF and DOCX files are read locally. Scanned or encrypted PDFs require OCR and are not supported.'},
  {question:'Why can the API report a slightly different count?',answer:'Providers can add message wrappers, system instructions, tools, or model-specific processing. The accuracy badge and methodology explain what this calculator includes.'},
];
---
<BaseLayout {title} {description} {canonical} {faq}>
  <section class="shell pt-16 pb-10 relative z-10">
    <span class="eyebrow">{eyebrow}</span>
    <div class="grid lg:grid-cols-[1fr_.65fr] gap-8 items-end mt-4"><h1 class="m-0 text-[clamp(2.7rem,7vw,5.8rem)] leading-[.94] tracking-[-.075em] max-w-4xl">{heading}</h1><p class="muted text-lg lg:mb-1 max-w-xl">{intro}</p></div>
  </section>
  <Calculator {provider}/>
  <section class="shell mt-24 grid md:grid-cols-2 gap-10 md:gap-20 relative z-10">
    <div><span class="eyebrow">How it works</span><h2 class="section-title mt-3">A measurement, not a guess disguised as fact.</h2></div>
    <div class="muted"><p>{methodology}</p><p>Every result identifies its method and accuracy level. Pricing links point to provider documentation and show when the registry was verified.</p><a href="/methodology" class="text-cyan-400">Read the complete methodology →</a></div>
  </section>
  <ProviderLinks/><FAQ items={faq}/>
</BaseLayout>
