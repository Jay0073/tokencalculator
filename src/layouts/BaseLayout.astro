---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { defaultLocale, locales, localizedPath, type Locale } from '../i18n/config';
import type { UserReview } from '../data/reviews';

interface Breadcrumb { label:string; href?:string }
interface ArticleMeta { headline:string; datePublished:string; dateModified:string; section:string; keywords?:string[]; type?:'BlogPosting'|'TechArticle' }
interface Props { title: string; description: string; canonical?: string; locale?:Locale; faq?: { question: string; answer: string }[]; application?:boolean; noindex?:boolean; breadcrumbs?:Breadcrumb[]; socialImage?:string; reviews?:UserReview[]; article?:ArticleMeta }
// Facebook, LinkedIn, X, Slack and Discord do not render an SVG preview card, so the
// fallback has to be a raster image. Pages without their own artwork share the
// site-wide PNG rather than an SVG that shows as a blank card.
const DEFAULT_SOCIAL_IMAGE = '/social/token-calculator.png';
const { title, description, canonical = Astro.url.pathname, locale=defaultLocale, faq = [], application=false, noindex=false, breadcrumbs=[], socialImage=DEFAULT_SOCIAL_IMAGE, reviews=[], article } = Astro.props;
const url = new URL(canonical, Astro.site ?? 'https://tokencalculator.dev');
const socialByPath:Record<string,string>={
  '/openai-token-counter/':'/social/openai-token-counter.png',
  '/claude-token-counter/':'/social/claude-token-counter.png',
  '/gemini-token-counter/':'/social/gemini-token-counter.png',
  '/deepseek-token-counter/':'/social/deepseek-token-counter.png',
};
const resolvedSocial = socialImage===DEFAULT_SOCIAL_IMAGE ? (socialByPath[url.pathname] ?? DEFAULT_SOCIAL_IMAGE) : socialImage;
const imageUrl = new URL(resolvedSocial, Astro.site ?? 'https://tokencalculator.dev');
const localizedHome = canonical === '/' || locales.some((item) => canonical === `/${item}/`);
const alternates = localizedHome ? locales.map((item) => ({ locale:item, href:new URL(localizedPath('/', item), Astro.site ?? 'https://tokencalculator.dev').href })) : [];
const schema = [
  { '@context':'https://schema.org', '@type':'WebSite', '@id':'https://tokencalculator.dev/#website', url:'https://tokencalculator.dev/', name:'TokenCalculator.dev', description:'A privacy-first, browser-based token calculator for major LLM providers.', inLanguage:locale, publisher:{ '@id':'https://tokencalculator.dev/#organization' } },
  // Google's Organization logo guidance expects a raster image with real dimensions;
  // an SVG is not eligible. sameAs and contactPoint give the entity something to
  // corroborate against.
  { '@context':'https://schema.org', '@type':'Organization', '@id':'https://tokencalculator.dev/#organization', name:'TokenCalculator.dev', url:'https://tokencalculator.dev/', description:'A privacy-first, browser-based LLM token calculator and free token counting API.', logo:{ '@type':'ImageObject', url:'https://tokencalculator.dev/social/token-calculator.png', width:1200, height:630 }, sameAs:['https://github.com/Jay0073/tokencalculator','https://www.npmjs.com/package/@jay0073/tokencalculator-core'], contactPoint:{ '@type':'ContactPoint', contactType:'technical support', email:'hello@tokencalculator.dev', url:'https://tokencalculator.dev/contact/' } },
  // One application, referenced from many pages. Minting a distinct @id per URL
  // declared twenty separate applications that happened to share a name.
  ...(application ? [{ '@context':'https://schema.org', '@type':'WebApplication', '@id':'https://tokencalculator.dev/#application', name:'TokenCalculator.dev', applicationCategory:'DeveloperApplication', operatingSystem:'All', url:'https://tokencalculator.dev/', description, inLanguage:locale, offers:{ '@type':'Offer', price:'0', priceCurrency:'USD' }, featureList:['Local token counting','File token estimation','Image token estimation','Context window measurement','Free token counting API'], ...(reviews.length ? { review:reviews.map((review) => ({ '@type':'Review', reviewBody:review.quote, datePublished:review.datePublished, reviewRating:{ '@type':'Rating', ratingValue:review.rating ?? 5, bestRating:5, worstRating:1 }, author:{ '@type':'Person', name:review.name }, itemReviewed:{ '@id':'https://tokencalculator.dev/#application' }, ...(review.sourceUrl ? { url:review.sourceUrl } : {}) })) } : {}) }] : []),
  ...(breadcrumbs.length > 1 ? [{ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:breadcrumbs.map((item,index)=>({ '@type':'ListItem', position:index+1, name:item.label, item:item.href ? new URL(item.href, Astro.site ?? 'https://tokencalculator.dev').href : url.href })) }] : []),
  ...(faq.length ? [{ '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faq.map((item) => ({ '@type':'Question', name:item.question, acceptedAnswer:{ '@type':'Answer', text:item.answer } })) }] : []),
  ...(article ? [{ '@context':'https://schema.org', '@type':article.type ?? 'BlogPosting', '@id':`${url.href}#article`, headline:article.headline, description, datePublished:article.datePublished, dateModified:article.dateModified, articleSection:article.section, keywords:article.keywords?.join(', '), inLanguage:locale, mainEntityOfPage:{ '@type':'WebPage', '@id':url.href }, author:{ '@type':'Organization', name:'TokenCalculator.dev Engineering', url:'https://tokencalculator.dev/about/' }, publisher:{ '@id':'https://tokencalculator.dev/#organization' }, image:imageUrl.href }] : []),
];
---
<!doctype html>
<html lang={locale}>
  <head>
    {/* Charset and viewport come first so the parser knows the encoding before any
        third-party script is fetched. Analytics follows below. */}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HREC4DEG8G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HREC4DEG8G');
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={url} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    {localizedHome && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site ?? 'https://tokencalculator.dev')} />}
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content="TokenCalculator.dev" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={url} /><meta property="og:image" content={imageUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="TokenCalculator.dev token measurement interface" /><meta property="og:locale" content={locale.replace('-', '_')} />{alternates.filter((item) => item.locale !== locale).map((item) => <meta property="og:locale:alternate" content={item.locale.replace('-', '_')} />)}
    {article && <meta property="article:published_time" content={article.datePublished} />}{article && <meta property="article:modified_time" content={article.dateModified} />}{article && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} /><meta name="twitter:image:alt" content="TokenCalculator.dev token measurement interface" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Both families are used above the fold. Without preloading the mono weights the
        browser only discovers them after CSS parses, which shows a visible font swap. */}
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    {schema.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body><Header {locale}/><main><slot /></main><Footer {locale} showDirectoryBadges={url.pathname==='/'} /></body>
</html>
