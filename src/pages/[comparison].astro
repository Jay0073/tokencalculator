const page = Astro.props as ComparisonPage;
const left = getModel(page.leftId);
const right = getModel(page.rightId);
const canonical = `/${page.slug}/`;
const breadcrumbs = [{ label: 'Token calculator', href: '/' }, { label: page.crumb }];
const money = (value: number | undefined) => value === undefined ? '—' : `$${value.toLocaleString('en-US', { maximumFractionDigits: 6 })}`;
---
<BaseLayout title={`${page.title} | TokenCalculator.dev`} description={page.description} {canonical} faq={page.faq} {breadcrumbs} application>
  <Breadcrumbs items={breadcrumbs} />
  <section class="shell max-w-4xl pt-12 sm:pt-16 pb-8 relative z-10">
    <span class="eyebrow">{page.eyebrow}</span>
    <h1 class="m-0 mt-4 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.02] tracking-[-.055em] max-w-4xl">{page.heading}</h1>
    <p class="muted text-[16px] sm:text-[17px] mt-4 mb-0 max-w-3xl">{page.intro}</p>
  </section>

  <section class="shell relative z-10 mb-8">
    <div class="panel p-5 sm:p-7">
      <p class="text-sm text-[var(--warn)] m-0 mb-5"><strong>Current-model note:</strong> {page.legacyTerms}</p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[620px] text-left text-sm">
          <thead><tr class="muted"><th class="pb-3">Current model</th><th class="pb-3">Input / 1M</th><th class="pb-3">Cached / 1M</th><th class="pb-3">Output / 1M</th><th class="pb-3">Context</th></tr></thead>
          <tbody>
            {[left, right].map((model) => <tr class="border-t hairline"><th class="py-4 pr-5"><span class="block">{model.name}</span><a class="text-xs text-[var(--accent)] font-normal" href={model.pricingUrl} target="_blank" rel="noreferrer">Official pricing ↗</a></th><td data-live-input={model.id}>{money(model.inputPerMillion)}</td><td>{money(model.cachedInputPerMillion)}</td><td data-live-output={model.id}>{money(model.outputPerMillion)}</td><td data-live-context={model.id}>{model.contextWindow.toLocaleString()}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="muted text-xs mb-0 mt-4">Rates verified {left.verifiedAt === right.verifiedAt ? left.verifiedAt : `${left.verifiedAt} / ${right.verifiedAt}`}. The browser may refresh them from the live catalogue. Provider pricing and tiers remain authoritative.</p>
    </div>
  </section>

  <section class="shell relative z-10 mb-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden bg-[var(--line)] border hairline">
      <div class="bg-[var(--panel)] p-5"><span class="eyebrow">Tokenization engine</span><p class="mt-2 mb-0 text-sm">{left.name}: {left.textAccuracy === 'exact' ? 'exact local BPE tokenization' : 'Provider-Calibrated UTF-8 Projection'}<br />{right.name}: {right.textAccuracy === 'exact' ? 'exact local BPE tokenization' : 'Provider-Calibrated UTF-8 Projection'}</p></div>
      <div class="bg-[var(--panel)] p-5"><span class="eyebrow">Documents</span><p class="mt-2 mb-0 text-sm">PDF, DOCX, code, text, and data files are extracted locally and applied to both models.</p></div>
      <div class="bg-[var(--panel)] p-5"><span class="eyebrow">Images</span><p class="mt-2 mb-0 text-sm">{left.name}: {left.vision ? 'documented formula' : 'unavailable'}<br />{right.name}: {right.vision ? 'documented formula' : 'unavailable'}</p></div>
      <div class="bg-[var(--panel)] p-5"><span class="eyebrow">Privacy</span><p class="mt-2 mb-0 text-sm">Prompt text, document contents, and image pixels stay in the browser.</p></div>
    </div>
  </section>

  <Calculator />

  <CostScenarios {left} {right} />

  {page.analysis.map((block) => (
    <section class="shell mt-16 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-8 md:gap-16 relative z-10">
      <div><h2 class="section-title m-0">{block.heading}</h2></div>
      <div class="muted">{block.body.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>
  ))}

  <section class="shell mt-16 grid md:grid-cols-2 gap-8 md:gap-16 relative z-10">
    <div><span class="eyebrow">Decision rule</span><h2 class="section-title mt-3">Model the workload, not the marketing price.</h2></div>
    <div class="muted"><p>{page.decision}</p><a href="/methodology/" class="text-[var(--accent)]">Review calculation methodology →</a></div>
  </section>
  <ProviderLinks current={canonical} limit={4} />
  <FAQ items={page.faq} />
</BaseLayout>
