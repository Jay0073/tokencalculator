---
import CalculatorPage from '../components/CalculatorPage.astro';
import type { ProviderId } from '../domain/models';

type ProviderPage={slug:string;provider:ProviderId;title:string;description:string;eyebrow:string;heading:string;intro:string;methodology:string;faq:{question:string;answer:string}[]};

export function getStaticPaths(){
  const pages:ProviderPage[]=[
    {slug:'openai',provider:'openai',title:'OpenAI Token Calculator and GPT Counter | TokenCalculator.dev',description:'Count GPT tokens locally with exact BPE tokenization. Check OpenAI API input cost and context-window usage.',eyebrow:'OpenAI token counter',heading:'Count OpenAI tokens exactly.',intro:'Paste text or attach files and images to inspect GPT token usage locally.',methodology:'OpenAI text is encoded locally with the model family’s BPE encoding. API message wrappers, tools, and hidden provider instructions can add tokens.',faq:[{question:'Which tokenizer does this OpenAI token calculator use?',answer:'It uses the local BPE encoding configured for the selected OpenAI model. Current GPT models in this catalog use o200k_base.'},{question:'Will the result match OpenAI API usage exactly?',answer:'The pasted content count is exact for its encoding, but a complete API request can add system messages, role wrappers, tool definitions, images, and provider-side tokens.'},{question:'How are OpenAI image tokens calculated?',answer:'The browser reads image dimensions and applies the published detail and tile rules for the selected vision model without uploading the image.'},{question:'Do system messages and tools add OpenAI tokens?',answer:'Yes. System instructions, role wrappers, tool schemas, and structured outputs may contribute tokens beyond the raw text pasted into this calculator.'}]},
    {slug:'claude',provider:'anthropic',title:'Claude Token Calculator and Cost Estimator | TokenCalculator.dev',description:'Analyze Claude tokens, image tokens, Anthropic input cost, and context-window utilization locally.',eyebrow:'Claude token counter',heading:'Analyze Claude token usage.',intro:'Measure prompts, documents, and images against current Claude models without uploading your content.',methodology:'Claude text uses the deterministic Provider-Calibrated UTF-8 Token Projection because Anthropic does not distribute its production tokenizer as a lightweight offline browser package. Images use Anthropic’s published 28×28 visual-patch rules and applicable model cap.',faq:[{question:'How does the Claude token projection work?',answer:'The engine computes UTF-8 byte length and applies an Anthropic-family bytes-per-token coefficient through a deterministic, reproducible projection. Anthropic’s production tokenizer is not distributed as a lightweight offline browser library.'},{question:'How are Claude image tokens calculated?',answer:'Image dimensions are processed locally with Anthropic’s published 28×28 visual-patch method and the applicable model cap.'},{question:'Why can Claude API usage differ from this projection?',answer:'API message framing, tool schemas, system instructions, punctuation, code, Unicode composition, and non-English content can change the final token usage reported by Anthropic.'},{question:'Does the calculator upload content to Anthropic?',answer:'No. The privacy-first calculation pipeline executes locally and does not call the Claude API. Anthropic receives nothing from this page.'}]},
    {slug:'gemini',provider:'google',title:'Gemini Token Calculator and Cost Estimator | TokenCalculator.dev',description:'Analyze Gemini tokens locally for text, documents, and images with Google AI pricing and context-window limits.',eyebrow:'Gemini token counter',heading:'Analyze Gemini token usage.',intro:'Measure text, documents, and images against current Gemini models in your browser.',methodology:'Gemini text uses a deterministic Provider-Calibrated UTF-8 Token Projection. Images follow Google’s published media-token allocation guidance. Google’s countTokens API remains authoritative for a fully assembled production request.',faq:[{question:'Does Gemini provide a token counting API?',answer:'Yes. Google’s countTokens API is authoritative for a fully assembled Gemini request. This privacy-first browser engine applies a deterministic provider-family UTF-8 projection without transmitting your input.'},{question:'How are Gemini image tokens calculated?',answer:'The browser reads image dimensions and applies Google’s published media-token allocation guidance. Image pixels remain on-device.'},{question:'Why does Gemini tokenize text differently from GPT?',answer:'Providers use different tokenizer vocabularies, segmentation strategies, Unicode handling, and multimodal processing rules, so identical content can produce different totals.'},{question:'Can Gemini count tokens in a PDF?',answer:'The client-side extraction pipeline converts readable PDF text and applies the Gemini projection. Scanned PDFs require OCR and are not supported.'}]},
    {slug:'deepseek',provider:'deepseek',title:'DeepSeek Token Counter and Cost Estimator | TokenCalculator.dev',description:'Analyze current DeepSeek model tokens, input cost, and context-window utilization locally.',eyebrow:'DeepSeek token counter',heading:'Analyze DeepSeek prompt tokens.',intro:'Measure text and readable documents against current DeepSeek production models.',methodology:'DeepSeek text uses the deterministic Provider-Calibrated UTF-8 Token Projection. Models without a documented vision-token specification return an unsupported state rather than a fabricated count.',faq:[{question:'How are DeepSeek tokens projected?',answer:'The engine computes UTF-8 byte length, applies a DeepSeek-family bytes-per-token coefficient, and then evaluates context-window utilization and current input pricing.'},{question:'Can reasoning change DeepSeek token usage?',answer:'Yes. Reasoning output, chat templates, request framing, and server-side processing can affect billed usage beyond the raw-input projection.'},{question:'Can this DeepSeek calculator count image tokens?',answer:'When the direct API model has no documented image-token specification, image calculation is marked unavailable rather than producing a fabricated number.'},{question:'Why can DeepSeek API billing differ from this result?',answer:'The provider may count request framing, reasoning, or other server-side content that is not present in the extracted input payload.'}]},
  ];
  return pages.map((page)=>({params:{provider:page.slug},props:page}));
}
const page=Astro.props as ProviderPage;
---
<CalculatorPage provider={page.provider} title={page.title} description={page.description} eyebrow={page.eyebrow} heading={page.heading} intro={page.intro} canonical={`/${page.slug}-token-counter/`} methodology={page.methodology} additionalFaq={page.faq} />
