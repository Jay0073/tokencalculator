---
import CalculatorPage from '../components/CalculatorPage.astro';
import type { ProviderId } from '../domain/models';

type ProviderPage={slug:string;provider:ProviderId;title:string;description:string;eyebrow:string;heading:string;intro:string;methodology:string;faq:{question:string;answer:string}[]};

export function getStaticPaths(){
  const pages:ProviderPage[]=[
    {slug:'openai',provider:'openai',title:'OpenAI Token Calculator — GPT Token Counter | TokenCalculator.dev',description:'Count GPT tokens locally with exact BPE tokenization. Check OpenAI API input cost and context-window usage.',eyebrow:'OpenAI token counter',heading:'Count OpenAI tokens exactly.',intro:'Paste text or attach files and images to inspect GPT token usage locally.',methodology:'OpenAI text is encoded locally with the model family’s BPE encoding. API message wrappers, tools, and hidden provider instructions can add tokens.',faq:[{question:'Which tokenizer does this OpenAI token calculator use?',answer:'It uses the local BPE encoding configured for the selected OpenAI model. Current GPT models in this catalog use o200k_base.'},{question:'Will the result match OpenAI API usage exactly?',answer:'The pasted content count is exact for its encoding, but a complete API request can add system messages, role wrappers, tool definitions, images, and provider-side tokens.'},{question:'How are OpenAI image tokens calculated?',answer:'The browser reads image dimensions and applies the published detail and tile rules for the selected vision model without uploading the image.'},{question:'Do system messages and tools add OpenAI tokens?',answer:'Yes. System instructions, role wrappers, tool schemas, and structured outputs may contribute tokens beyond the raw text pasted into this calculator.'}]},
    {slug:'claude',provider:'anthropic',title:'Claude Token Calculator — Anthropic Cost Estimator | TokenCalculator.dev',description:'Estimate Claude tokens, image tokens, Anthropic input cost, and context-window usage locally.',eyebrow:'Claude token counter',heading:'Estimate Claude token usage.',intro:'Measure prompts, documents, and images against current Claude models without uploading your content.',methodology:'Claude text uses a transparent calibrated estimate because Anthropic does not publish a lightweight offline browser tokenizer. Images use Anthropic’s published visual-patch rules.',faq:[{question:'Why is the Claude token count an estimate?',answer:'Anthropic’s production tokenizer is not distributed as a lightweight offline browser library, so this tool uses a deterministic calibrated ratio and labels the result clearly.'},{question:'How are Claude image tokens calculated?',answer:'Image dimensions are processed locally with Anthropic’s published 28×28 visual-patch method and the applicable model cap.'},{question:'Why can Claude API usage differ from this estimate?',answer:'API messages, tools, system instructions, punctuation, code, and non-English content can change the final token usage reported by Anthropic.'},{question:'Does the calculator upload content to Anthropic?',answer:'No. The calculator runs locally and does not call the Claude API. Anthropic receives nothing from this page.'}]},
    {slug:'gemini',provider:'google',title:'Gemini Token Calculator — Google AI Cost Estimator | TokenCalculator.dev',description:'Estimate Gemini tokens locally for text, documents, and images with Google AI pricing and context limits.',eyebrow:'Gemini token counter',heading:'Estimate Gemini token usage.',intro:'Measure text, documents, and images against current Gemini models in your browser.',methodology:'Gemini text uses a deterministic provider-family estimate. Images follow Google’s published media token guidance. The Gemini countTokens API is authoritative.',faq:[{question:'Does Gemini provide a token counting API?',answer:'Yes. Google’s countTokens API is the authoritative count for a fully assembled Gemini request. This browser tool provides a private planning estimate without sending the input.'},{question:'How are Gemini image tokens estimated?',answer:'The browser reads image dimensions and applies Google’s published media allocation guidance. The image itself stays on the device.'},{question:'Why does Gemini count text differently from GPT?',answer:'Providers use different tokenization systems and multimodal processing rules, so the same text or image can produce different totals.'},{question:'Can Gemini count tokens in a PDF?',answer:'This tool extracts readable PDF text locally and estimates it for Gemini. Scanned PDFs require OCR and are not supported.'}]},
    {slug:'deepseek',provider:'deepseek',title:'DeepSeek Token Calculator — API Cost Estimator | TokenCalculator.dev',description:'Estimate current DeepSeek model tokens, input cost, and context-window usage locally.',eyebrow:'DeepSeek token counter',heading:'Estimate DeepSeek prompt tokens.',intro:'Measure text and readable documents against current DeepSeek production models.',methodology:'DeepSeek text uses a calibrated provider-family estimate. Models without documented image input show an unsupported state rather than an invented count.',faq:[{question:'How are DeepSeek tokens estimated?',answer:'The calculator uses a deterministic calibrated ratio for DeepSeek text, then applies the selected model’s context limit and current input price.'},{question:'Can reasoning change DeepSeek token usage?',answer:'Yes. Reasoning output, message templates, and server-side processing can affect billed usage beyond the raw input estimate.'},{question:'Can this DeepSeek calculator count image tokens?',answer:'When the direct API model has no documented image-token rule, image calculation is marked unavailable instead of producing an invented number.'},{question:'Why can DeepSeek API billing differ from this result?',answer:'The provider may count request framing, reasoning, or other server-side content that is not present in the pasted text.'}]},
  ];
  return pages.map((page)=>({params:{provider:page.slug},props:page}));
}
const page=Astro.props as ProviderPage;
---
<CalculatorPage provider={page.provider} title={page.title} description={page.description} eyebrow={page.eyebrow} heading={page.heading} intro={page.intro} canonical={`/${page.slug}-token-counter/`} methodology={page.methodology} additionalFaq={page.faq} />
