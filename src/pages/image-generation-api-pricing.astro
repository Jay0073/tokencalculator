---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FAQ from '../components/seo/FAQ.astro';
import { BASIS_LABEL, IMAGE_MODELS, IMAGE_PAGES, IMAGE_PRICES_CHECKED, imageUsd } from '../data/image-models';

// Overview of image-generation API prices. Prices are hand-maintained in
// src/data/image-models.ts because models.dev has no per-image price field.
const canonical = '/image-generation-api-pricing/';
const breadcrumbs = [{ label: 'Token calculator', href: '/' }, { label: 'Compare models', href: '/compare/' }, { label: 'Image generation API pricing' }];
const VOLUME = 10000;
const checked = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${IMAGE_PRICES_CHECKED}T00:00:00Z`));
const pairs = IMAGE_PAGES.filter((page) => page.href !== canonical);
const faq = [
  { question: 'What is the cheapest image generation API?', answer: 'At about 1024×1024, GPT Image 2.5 at low quality costs about $0.0059 per image, and Nano Banana 2 Lite costs $0.0336, or $0.0168 through Google\'s Batch API. Among models without a quality dial, Grok Imagine Image 2.0 costs a flat $0.04 and Seedream 5.0 Pro costs $0.045.' },
  { question: 'How much does GPT Image 2.5 cost per image?', answer: 'For 1024×1024: about $0.0059 at low, $0.013 at medium, $0.053 at high, $0.094 at xhigh and $0.21 at max quality. The largest size, 2880×2880 at max, costs about $0.71. Flare and Sunburst cost the same.' },
  { question: 'How much does Nano Banana 2 cost per image?', answer: '$0.045 at 0.5K, $0.067 at 1K, $0.101 at 2K and $0.151 at 4K. The Batch API halves each price. Nano Banana Pro costs $0.134 at 1K or 2K and $0.24 at 4K.' },
  { question: 'Why is MAI-Image-2.6 marked as an estimate?', answer: 'Microsoft bills MAI-Image-2.6 per token but does not publish how many tokens one image uses, so its cost per image cannot be calculated from official figures. The figure shown, about $0.039 per image, comes from third-party trackers.' },
  { question: 'Do image generation APIs offer batch discounts?', answer: 'Google halves Nano Banana prices through its Batch API. OpenAI has no batch pricing for GPT Image 2.5. xAI accepts image requests in its Batch API but bills them at the standard rate.' },
];
---
<BaseLayout title="AI Image Generation API Pricing Compared (2026)" description="Cost per image for GPT Image 2.5, Nano Banana 2, Grok Imagine, Seedream 5.0 and MAI-Image-2.6, by size and quality, with a monthly cost estimator." {canonical} {faq} {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="shell max-w-4xl pt-12 sm:pt-16 pb-8 relative z-10">
    <span class="eyebrow">Image model comparison</span>
    <h1 class="m-0 mt-4 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.02] tracking-[-.055em] max-w-4xl">Image generation API pricing, compared.</h1>
    <p class="muted text-[16px] sm:text-[17px] mt-4 mb-0 max-w-3xl">At about 1024×1024, Grok Imagine Image 2.0 costs a flat $0.04 per image, Seedream 5.0 Pro $0.045 and Nano Banana 2 $0.067. GPT Image 2.5 ranges from about $0.006 at low quality to $0.21 at max. Prices below were checked on {checked} against each provider's pricing page.</p>
  </section>

  <section class="shell relative z-10 mb-10" aria-labelledby="table-title">
    <div class="panel p-5 sm:p-7" data-image-estimator>
      <h2 id="table-title" class="section-title m-0 mb-2">Cost per image and per month</h2>
      <p class="muted text-sm mt-0 mb-5">Standard processing, output images only. The monthly column updates with your volume.</p>
      <label class="flex flex-wrap items-center gap-3 text-sm mb-5">Images per month
        <input class="h-10 w-40 rounded-lg border hairline bg-[var(--panel)] px-3 mono" type="number" min="0" step="1000" value={VOLUME} data-image-volume />
      </label>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead><tr class="muted"><th class="pb-3 font-normal">Model</th><th class="pb-3 font-normal">About 1024×1024</th><th class="pb-3 font-normal text-right">Per image</th><th class="pb-3 font-normal text-right">Per month</th><th class="pb-3 font-normal text-right">Highest tier</th><th class="pb-3 pl-4 font-normal">Price basis</th></tr></thead>
          <tbody>
            {IMAGE_MODELS.flatMap((model) => model.standard.map((price, index) => (
              <tr class="border-t hairline">
                <th class="py-3 pr-4 font-semibold">{index === 0 ? <>{model.name}<span class="block muted text-xs font-normal">{model.lab} · {model.status}</span></> : ''}</th>
                <td class="py-3 pr-4">{price.label}{price.batchUsd !== undefined && <span class="block muted text-xs">Batch {imageUsd(price.batchUsd)}</span>}</td>
                <td class="py-3 text-right mono">{imageUsd(price.usd)}</td>
                <td class="py-3 text-right mono" data-image-price={price.usd}>${(price.usd * VOLUME).toLocaleString('en-US', { maximumFractionDigits: 0 })}</td>
                <td class="py-3 text-right mono">{index === 0 ? <>{imageUsd(model.best.usd)}<span class="block muted text-xs font-sans">{model.best.label}</span></> : ''}</td>
                <td class="py-3 pl-4 text-xs muted">{index === 0 ? BASIS_LABEL[model.priceBasis] : ''}</td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
      <p class="muted text-xs mt-4 mb-0">Published: the provider lists a price per image. Calculated: the provider bills per token and publishes the token counts. Estimate: the provider publishes neither, so the figure comes from third-party trackers.</p>
    </div>
  </section>

  <section class="shell mt-16 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-8 md:gap-16 relative z-10">
    <div><h2 class="section-title m-0">On per-token APIs, quality matters more than the model</h2></div>
    <div class="muted">
      <p>OpenAI, Google and Microsoft bill image output by the token. On GPT Image 2.5 the quality setting changes the token count so much that the same 1024×1024 image costs 36 times more at max than at low.</p>
      <p>Google fixes the token count per resolution instead, so a Nano Banana 2 image costs the same whatever the prompt: $0.067 at 1K. xAI and ByteDance skip tokens entirely and charge a flat price per image.</p>
      <p>The practical rule: decide the size and quality your product needs first, then compare prices at that tier. Comparing default settings compares the wrong numbers.</p>
    </div>
  </section>

  <section class="shell mt-16 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-8 md:gap-16 relative z-10">
    <div><h2 class="section-title m-0">Price and ranking do not line up</h2></div>
    <div class="muted">
      <p>On the Arena text-to-image leaderboard updated on 7 September 2026, GPT Image 2.5 Sunburst ranked first and Flare second, both marked preliminary. MAI-Image-2.6 ranked fourth, Grok Imagine Image 2.0 fifth, Nano Banana 2 ninth, Seedream 5.0 Pro tenth and Nano Banana Pro fourteenth.</p>
      <p>Nano Banana Pro costs twice as much as Nano Banana 2 and ranked lower on that board. A higher price is not a reliable sign of a better image, so test on your own prompts.</p>
    </div>
  </section>

  <section class="shell mt-16 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-8 md:gap-16 relative z-10">
    <div><h2 class="section-title m-0">Batch and editing change the answer</h2></div>
    <div class="muted">
      <p>Google halves Nano Banana prices through its Batch API, which makes Nano Banana 2 Lite $0.0168 and Nano Banana 2 $0.034 per 1K image. OpenAI has no batch pricing for GPT Image 2.5, and xAI bills batch images at the standard rate.</p>
      <p>Editing adds input images. Google charges a fraction of a cent for each; ByteDance makes the first Seedream reference image free and charges $0.003 for each extra one; OpenAI bills input images at $8 per million tokens without publishing a fixed count per image. The <a class="text-[var(--accent)]" href="/docs/image-generation-cost/">image cost documentation</a> explains each billing model.</p>
    </div>
  </section>

  <section class="shell mt-16 relative z-10">
    <span class="eyebrow">Head-to-head</span><h2 class="section-title mt-3 mb-6">Compare two image models</h2>
    <div class="grid md:grid-cols-2 gap-3">
      {pairs.map((page) => <a href={page.href} class="panel rounded-xl p-5 no-underline hover:border-[var(--line-strong)]"><strong>{page.title}</strong><span class="block text-sm muted mt-1">{page.detail}</span></a>)}
    </div>
  </section>

  <FAQ items={faq} />

  <section class="shell mt-12 mb-8 relative z-10">
    <div class="source-ledger mt-0"><h2>Sources</h2><p><strong>Prices checked:</strong> {checked}. Image prices change often; provider pricing pages remain authoritative.</p><ul>
      {IMAGE_MODELS.flatMap((model) => model.sources).filter((source, index, all) => all.findIndex((other) => other.url === source.url) === index).map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>)}
      <li><a href="https://arena.ai/leaderboard/text-to-image" target="_blank" rel="noreferrer">Arena text-to-image leaderboard</a> (updated 7 September 2026)</li>
    </ul></div>
  </section>
</BaseLayout>

<script>
  // Recompute the monthly column when the volume changes. The server already rendered
  // the numbers for 10,000 images, so the table is complete without JavaScript.
  for (const root of document.querySelectorAll<HTMLElement>('[data-image-estimator]')) {
    const input = root.querySelector<HTMLInputElement>('[data-image-volume]');
    const cells = root.querySelectorAll<HTMLElement>('[data-image-price]');
    input?.addEventListener('input', () => {
      const volume = Math.max(0, Number(input.value) || 0);
      cells.forEach((cell) => { cell.textContent = `$${(Number(cell.dataset.imagePrice) * volume).toLocaleString('en-US', { maximumFractionDigits: 0 })}`; });
    });
  }
</script>
