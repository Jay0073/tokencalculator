# Security headers for every static response.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://models.dev https://www.google-analytics.com https://*.google-analytics.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# HTML is revalidated rather than blindly cached, but a short freshness window plus
# stale-while-revalidate lets a repeat visit paint from cache while the check happens
# in the background. Cloudflare purges on deploy, so staleness is bounded.
/*.html
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400, must-revalidate

/
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400, must-revalidate

# Discovery files change only on deploy and are polled by crawlers and agents.
/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/openapi.json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/social/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
