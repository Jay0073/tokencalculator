{
  "name": "tokencalculator-dev",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://tokencalculator.dev",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "tsc -p packages/tokencalculator-core/tsconfig.json",
    "pack:core": "npm pack --dry-run --workspace @jay0073/tokencalculator-core",
    "build:n8n": "npm run build --workspace @jay0073/n8n-nodes-tokencalculator",
    "pack:n8n": "npm pack --dry-run --workspace @jay0073/n8n-nodes-tokencalculator"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "js-tiktoken": "latest",
    "mammoth": "latest",
    "pdfjs-dist": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "workspaces": ["packages/*"]
}
